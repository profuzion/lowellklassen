# Stripe secret key. Required to create Checkout Sessions.
# TODO: Add your Stripe secret key.
STRIPE_SECRET_KEY=

# Publishable key for the embedded checkout on the Audit page.
# Developers → API keys. Starts with pk_test_ or pk_live_.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public site URL used for success and cancel redirects.
# TODO: Set this to the production URL before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Price IDs for each product. Create these in the Stripe Dashboard.
# TODO: Add the workbook price ID.
STRIPE_PRICE_WORKBOOK=

# Stripe Price ID for The Brand Clarity Audit ($27 CAD, one-time).
# STRIPE_AUDIT_PRICE_ID is also accepted.
STRIPE_PRICE_AUDIT=

# Set to on only if you are registered for GST/HST and Stripe Tax is configured.
STRIPE_TAX=

# Webhook signing secret for /api/stripe/webhook.
# Events: checkout.session.completed, checkout.session.async_payment_succeeded.
STRIPE_WEBHOOK_SECRET=

# Where the paid PDF lives. It must stay out of /public.
# On this machine the fillable workbook is:
# AUDIT_PDF_PATH="E:/PFS/AI Avatar/Lead Magnets/Brand-Clarity-Audit.pdf"
# Production can use that path, private/Brand-Clarity-Audit.pdf, or AUDIT_PDF_URL.
AUDIT_PDF_PATH=
AUDIT_PDF_URL=

# Kit tag applied to buyers, and the custom field audit_download_url.
KIT_AUDIT_TAG_ID=

# Kit (ConvertKit) v3 key for the Name It Right worksheet signup.
# Settings > Developer > API Key. This is the v3 key, not the API secret.
KIT_API_KEY=

# The Kit form that sends the worksheet. The number in the form URL.
KIT_FORM_ID=

# Optional numeric id of a Kit tag applied to new subscribers.
KIT_TAG_ID=
